# DevFlow local environment.
#
# Copy this file to .env, then run ./scripts/init-devflow.sh.

# Public Woodpecker URL used by browsers, OAuth callbacks, and links generated
# by Woodpecker. DevFlow reserves the 52xx host port range.
WOODPECKER_HOST=http://localhost:5201

# Forge URL used by Woodpecker. Keep this as gitea.localhost so links, OAuth,
# and repository metadata use the same public forge URL.
# The local clone wrapper rewrites clone traffic to gitea:5200 inside Docker.
WOODPECKER_GITEA_URL=http://gitea.localhost:5200

# Public Gitea URL used during browser-based OAuth login.
WOODPECKER_EXPERT_FORGE_OAUTH_HOST=http://gitea.localhost:5200

# Internal Docker-network URL that Gitea webhooks call to reach Woodpecker.
# Keeping this internal avoids routing container-to-container traffic through
# the host port.
WOODPECKER_EXPERT_WEBHOOK_HOST=http://woodpecker-server:8000

# Shared secret used by Woodpecker server and agent. The initializer replaces
# this placeholder with a generated value.
WOODPECKER_AGENT_SECRET=replace-with-random-secret

# First admin account. The initializer prompts for these values if they still
# contain placeholders, then saves the answers back to .env.
# scripts/init-devflow.sh creates this Gitea admin user, and docker-compose.yml
# passes the same username to Woodpecker as WOODPECKER_ADMIN.
GITEA_ADMIN_USERNAME=replace-with-your-gitea-admin-username
GITEA_ADMIN_EMAIL=replace-with-your-email@example.com

# Use single quotes when the password contains spaces or shell-sensitive
# characters such as $, !, #, &, or ;. Avoid single quotes inside the password.
GITEA_ADMIN_PASSWORD='replace-with-a-strong-password'

# Fill these after creating an OAuth2 application in Gitea.
# Callback URL: http://localhost:5201/authorize
# The first initializer run creates the Gitea admin account. Then log in to
# Gitea, create the OAuth2 application, paste these values here, and run the
# initializer again to start Woodpecker.
WOODPECKER_GITEA_CLIENT=replace-with-gitea-oauth-client-id
WOODPECKER_GITEA_SECRET=replace-with-gitea-oauth-client-secret
